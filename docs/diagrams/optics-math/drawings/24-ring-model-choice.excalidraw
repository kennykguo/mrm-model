      "customData": {
        "latex": "\\begin{array}{ll}a\\ [1]&\\text{round-trip field retention}\\\\[0.6em]k_1,k_2\\ [1]&\\text{cross-coupling amplitudes}\\\\[0.6em]T_{\\mathrm{rt}}\\ [\\mathrm s]&\\text{round-trip group delay}\\\\[0.6em]\\kappa_i,\\kappa_e,\\kappa_d\\ [\\mathrm{s}^{-1}]&\\text{energy decay rates}\\\\[0.6em]g\\ [\\mathrm{rad/s}]&\\text{CW-CCW mode coupling}\\\\[0.6em]r_{b,n}\\ [1]&\\text{round-trip backscatter}\\\\[0.6em]\\phi\\ [\\mathrm{rad}]&\\text{round-trip phase}\\\\[0.6em]n\\in\\mathbb Z&\\text{longitudinal order}\\\\[0.6em]A_+,A_-\\ [\\sqrt{\\mathrm J}]&\\text{TCMT mode amplitudes}\\\\[0.6em]d_+,d_-\\ [\\sqrt{\\mathrm J}/\\mathrm s]&\\text{mode drives}\\end{array}"
