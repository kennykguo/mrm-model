      "customData": {
        "latex": "\\begin{array}{ll}P_{\\mathrm{monitor}}\\ [\\mathrm W]&\\text{drop optical power}\\\\[0.6em]I_{\\mathrm{PD}}\\ [\\mathrm A]&\\text{photodiode current}\\\\[0.6em]y\\ [\\mathrm{codes}]&\\text{ADC reading}\\\\[0.6em]\\mathcal R\\ [\\mathrm{A/W}]&\\text{responsivity}\\\\[0.6em]I_0,I_{\\mathrm d}\\ [\\mathrm A]&\\text{reference, dark current}\\\\[0.6em]E_a\\ [\\mathrm J]&\\text{activation energy}\\\\[0.6em]k_B\\ [\\mathrm{J/K}]&\\text{Boltzmann constant}\\\\[0.6em]T_{\\mathrm{PD}},T_0\\ [\\mathrm K]&\\text{diode, reference temperature}\\\\[0.6em]h_{\\mathrm{int}},\\tau_{\\mathrm{ADC}}\\ [\\mathrm s]&\\text{integration, latency}\\\\[0.6em]G\\ [\\mathrm{codes/A}]&\\text{conversion gain}\\\\[0.6em]\\nu\\ [\\mathrm{codes}]&\\text{measurement noise}\\\\[0.6em]b_{\\mathrm{ADC}}\\ [1]&\\text{ADC bit count}\\end{array}"
      },
